<!DOCTYPE html>
<html lang="en">

<head>
    <link rel="stylesheet" href="/styles.css">
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Editting for SEO</title>
</head>

<body>
    <h1>Edit post</h1>
    <form action="/posts/<%= post.blog_id %>/edit" method="POST">
        <label for="author">Author</label>
        <input type="text" id="author" name="author" value="<%= post.creator_name %>" readonly>

        <label for="title">Title</label>
        <input type="text" id="title" name="title" value="<%= post.title %>" maxlength="255" required>

        <label for="body">Post content</label>
        <textarea id="body" name="body" rows="7" required><%= post.body %></textarea>

        <button type="submit">Save changes</button>
    </form>
</body>

</html>